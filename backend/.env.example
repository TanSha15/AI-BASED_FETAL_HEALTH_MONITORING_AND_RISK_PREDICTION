# Fetal Health Monitoring System - Environment Configuration
PROJECT_NAME="AI-Based Fetal Health Monitoring and Risk Prediction System"
VERSION="1.0.0"

# MongoDB Database Connection
# Use local MongoDB daemon or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=fetal_health_db

# Security & JWT Authentication
JWT_SECRET_KEY=fetal_health_clinical_secure_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Model Configuration
MODEL_PATH=../ml/models/fetal_health_model.pkl

# Google Gemini API Key for Clinical Generative AI Explanation (Optional)
# If empty, an automated structured clinical rule-based explanation is generated.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

